# Copy this file to .env and fill in your own values.
# Never commit the real .env file -- it's already in .gitignore.

# Found on your Foundry project's overview page, or the resource's "Keys and Endpoint" page
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-key>

# API version -- update if Azure asks for a newer one
AZURE_OPENAI_API_VERSION=2026-01-01-preview

# The DEPLOYMENT NAME you chose when deploying a chat model in the Foundry
# portal (Module 4-6 of the Azure AI Teaching Guide) -- not the underlying
# model name itself.
AZURE_OPENAI_CHAT_DEPLOYMENT=<your-chat-deployment-name>

# Only needed for module03_embeddings.py -- deploy a text-embedding-3-small
# (or similar) model and put its deployment name here.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=<your-embedding-deployment-name>
